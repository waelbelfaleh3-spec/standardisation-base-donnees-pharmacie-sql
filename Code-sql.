-- ============================================================
-- PROJET : Standardisation d'une Base de Données Sale
--          Ventes d'une Pharmacie Locale
-- Auteur  : [Ton Nom] | Data Analyst Freelance
-- Date    : 2025
-- Base    : SQLite (compatible PostgreSQL avec adaptations mineures)
-- ============================================================
-- CONTEXTE MÉTIER :
--   Une pharmacie gérait ses ventes sur un vieux logiciel
--   de caisse qui n'imposait aucune règle de saisie.
--   Résultat après 2 ans : une base de données inexploitable.
--   Un même médicament apparaît sous 5 formes différentes,
--   les dates sont dans 3 formats distincts, des ventes sont
--   saisies en double et les prix manquants bloquent tout
--   calcul de marge. Ce projet nettoie et standardise
--   l'intégralité de la base pour la rendre analysable.
--
-- PROBLÈMES IDENTIFIÉS DANS LES DONNÉES BRUTES :
--   1. Noms de médicaments incohérents (casse, espaces, fautes)
--   2. Formats de dates hétérogènes (DD/MM/YYYY, MM-DD-YYYY, YYYY-MM-DD)
--   3. Doublons : lignes de vente saisies deux fois par erreur
--   4. Valeurs NULL : prix manquants bloquant les calculs de marge
-- ============================================================


-- ============================================================
-- PARTIE 1 : CRÉATION DE LA TABLE BRUTE
-- ============================================================
-- On simule exactement ce qu'on reçoit du client :
-- une seule table plate, mal saisie, sans contraintes.
-- C'est la réalité de 90% des missions de nettoyage.
-- ============================================================

CREATE TABLE ventes_brutes (
    vente_id        INTEGER PRIMARY KEY,
    medicament      TEXT,           -- Saisie libre = incohérences garanties
    date_vente      TEXT,           -- Stocké en TEXT car formats mélangés
    quantite        INTEGER,
    prix_unitaire   REAL,           -- NULL quand le caissier a oublié
    vendeur         TEXT
);


