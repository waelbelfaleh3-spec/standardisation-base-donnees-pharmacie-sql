-- ============================================================
-- PARTIE 3 : DIAGNOSTIC — Photographier les problèmes
-- ============================================================
-- Avant de nettoyer, on MESURE l'ampleur des dégâts.
-- C'est ce qu'on montre au client pour justifier le travail.
-- ============================================================


-- ------------------------------------------------------------
-- DIAGNOSTIC 1 : Combien de noms différents par médicament ?
-- ------------------------------------------------------------
-- UPPER() : met tout en majuscules pour regrouper les variantes
-- TRIM()  : supprime les espaces avant et après
-- ------------------------------------------------------------

SELECT
    UPPER(TRIM(medicament))      AS medicament_normalise,
    COUNT(*)                     AS nb_variantes_trouvees,
    GROUP_CONCAT(DISTINCT medicament, ' | ') AS formes_dans_la_base
FROM ventes_brutes
GROUP BY UPPER(TRIM(medicament))
ORDER BY nb_variantes_trouvees DESC;


-- ------------------------------------------------------------
-- DIAGNOSTIC 2 : Identifier les doublons exacts
-- ------------------------------------------------------------
-- Un doublon = même médicament, même date, même quantité,
-- même prix, même vendeur → saisie en double par erreur.
-- ------------------------------------------------------------

SELECT
    UPPER(TRIM(medicament))      AS medicament,
    date_vente,
    quantite,
    prix_unitaire,
    vendeur,
    COUNT(*)                     AS nb_occurrences,
    GROUP_CONCAT(vente_id, ', ') AS ids_en_doublon
FROM ventes_brutes
GROUP BY
    UPPER(TRIM(medicament)),
    date_vente,
    quantite,
    prix_unitaire,
    vendeur
HAVING nb_occurrences > 1;


-- ------------------------------------------------------------
-- DIAGNOSTIC 3 : Compter les valeurs NULL et leur impact
-- ------------------------------------------------------------

SELECT
    COUNT(*)                                         AS total_lignes,
    SUM(CASE WHEN prix_unitaire IS NULL THEN 1 ELSE 0 END)
                                                     AS lignes_sans_prix,
    SUM(CASE WHEN medicament IS NULL THEN 1 ELSE 0 END)
                                                     AS lignes_sans_medicament,
    ROUND(
        SUM(CASE WHEN prix_unitaire IS NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
        1
    )                                                AS pct_lignes_bloquees
FROM ventes_brutes;


-- ============================================================
-- PARTIE 4 : NETTOYAGE — On corrige chaque problème
-- ============================================================


-- ------------------------------------------------------------
-- NETTOYAGE 1 : Créer la table propre (structure cible)
-- ------------------------------------------------------------
-- Bonne pratique : on ne modifie JAMAIS la table source.
-- On crée une table propre séparée. Ainsi :
--   - La donnée brute originale est préservée (auditabilité)
--   - En cas d'erreur, on peut tout recommencer sans risque
--   - Le client peut comparer avant/après
-- ------------------------------------------------------------

CREATE TABLE ventes_propres (
    vente_id        INTEGER PRIMARY KEY,
    medicament      TEXT    NOT NULL,
    date_vente      TEXT    NOT NULL,
    quantite        INTEGER NOT NULL,
    prix_unitaire   REAL    NOT NULL,
    vendeur         TEXT    NOT NULL,
    source_vente_id INTEGER
);


-- ------------------------------------------------------------
-- NETTOYAGE 2 : Calculer le prix moyen par médicament
-- ------------------------------------------------------------
-- Pour remplacer les NULL, on calcule le prix moyen du
-- médicament sur les lignes où le prix est renseigné.
-- AVG() ignore automatiquement les NULL : parfait ici.
-- ------------------------------------------------------------

CREATE TEMP TABLE prix_moyens AS
SELECT
    UPPER(TRIM(medicament))          AS medicament_cle,
    ROUND(AVG(prix_unitaire), 2)     AS prix_moyen
FROM ventes_brutes
WHERE prix_unitaire IS NOT NULL
GROUP BY UPPER(TRIM(medicament));


-- ------------------------------------------------------------
-- NETTOYAGE 3 : Insérer les données nettoyées
-- ------------------------------------------------------------
-- On applique TOUTES les corrections en une seule requête :
--
--   TRIM()      → supprime les espaces parasites
--   UPPER/LOWER → normalise la casse (ex: "Doliprane")
--   CASE WHEN   → détecte le format de date et le convertit
--   COALESCE    → remplace les NULL par le prix moyen
--   GROUP BY    → élimine les doublons à la source
-- ------------------------------------------------------------

INSERT INTO ventes_propres
SELECT
    MIN(vb.vente_id)                AS vente_id,

    -- Standardisation du nom : 1ère lettre majuscule, reste minuscule
    -- "  DOLIPRANE  " → "Doliprane"
    UPPER(SUBSTR(TRIM(vb.medicament), 1, 1)) ||
    LOWER(SUBSTR(TRIM(vb.medicament), 2))    AS medicament,

    -- Conversion de date : détection du format via LIKE
    -- puis reconstruction en YYYY-MM-DD dans tous les cas
    CASE
        -- Format DD/MM/YYYY → extraire et réordonner
        WHEN vb.date_vente LIKE '__/__/____'
        THEN SUBSTR(vb.date_vente, 7, 4) || '-' ||  -- Année
             SUBSTR(vb.date_vente, 4, 2) || '-' ||  -- Mois
             SUBSTR(vb.date_vente, 1, 2)             -- Jour

        -- Format MM-DD-YYYY → même logique avec tirets
        WHEN vb.date_vente LIKE '__-__-____'
        THEN SUBSTR(vb.date_vente, 7, 4) || '-' ||  -- Année
             SUBSTR(vb.date_vente, 1, 2) || '-' ||  -- Mois
             SUBSTR(vb.date_vente, 4, 2)             -- Jour

        -- Format YYYY-MM-DD → déjà correct, on garde tel quel
        ELSE vb.date_vente
    END                             AS date_vente,

    vb.quantite,

    -- COALESCE : prend le prix réel s'il existe, sinon la moyenne
    -- Jamais de 0 ou de valeur fictive : on utilise la vraie moyenne
    COALESCE(vb.prix_unitaire, pm.prix_moyen) AS prix_unitaire,

    TRIM(vb.vendeur)                AS vendeur,
    vb.vente_id                     AS source_vente_id

FROM ventes_brutes vb
LEFT JOIN prix_moyens pm
    ON UPPER(TRIM(vb.medicament)) = pm.medicament_cle

-- GROUP BY : deux lignes identiques sur ces critères = doublon supprimé
-- On applique la même conversion de date dans le GROUP BY
-- pour ne pas rater les doublons avec formats différents
GROUP BY
    UPPER(TRIM(vb.medicament)),
    CASE
        WHEN vb.date_vente LIKE '__/__/____'
        THEN SUBSTR(vb.date_vente, 7, 4) || '-' ||
             SUBSTR(vb.date_vente, 4, 2) || '-' ||
             SUBSTR(vb.date_vente, 1, 2)
        WHEN vb.date_vente LIKE '__-__-____'
        THEN SUBSTR(vb.date_vente, 7, 4) || '-' ||
             SUBSTR(vb.date_vente, 1, 2) || '-' ||
             SUBSTR(vb.date_vente, 4, 2)
        ELSE vb.date_vente
    END,
    vb.quantite,
    vb.vendeur;


-- ============================================================
-- PARTIE 5 : VÉRIFICATION — Prouver que le nettoyage a marché
-- ============================================================


-- ------------------------------------------------------------
-- VÉRIF 1 : Rapport avant/après — Vue d'ensemble
-- ------------------------------------------------------------

SELECT '=== RAPPORT DE NETTOYAGE ===' AS rapport;

SELECT
    'AVANT' AS etape,
    COUNT(*)                                         AS total_lignes,
    COUNT(DISTINCT UPPER(TRIM(medicament)))          AS medicaments_distincts,
    SUM(CASE WHEN prix_unitaire IS NULL THEN 1 ELSE 0 END)
                                                     AS lignes_avec_null
FROM ventes_brutes

UNION ALL

SELECT
    'APRES' AS etape,
    COUNT(*)                                         AS total_lignes,
    COUNT(DISTINCT medicament)                       AS medicaments_distincts,
    SUM(CASE WHEN prix_unitaire IS NULL THEN 1 ELSE 0 END)
                                                     AS lignes_avec_null
FROM ventes_propres;


-- ------------------------------------------------------------
-- VÉRIF 2 : Contrôle des noms standardisés
-- ------------------------------------------------------------

SELECT
    medicament,
    COUNT(*)         AS nb_ventes,
    MIN(date_vente)  AS premiere_vente,
    MAX(date_vente)  AS derniere_vente
FROM ventes_propres
GROUP BY medicament
ORDER BY medicament ASC;


-- ------------------------------------------------------------
-- VÉRIF 3 : Contrôle des dates — doit retourner 0 ligne
-- ------------------------------------------------------------

SELECT
    COUNT(*) AS dates_mal_formatees
FROM ventes_propres
WHERE date_vente NOT LIKE '____-__-__';


-- ------------------------------------------------------------
-- VÉRIF 4 : Contrôle des NULL — doit retourner 0
-- ------------------------------------------------------------

SELECT
    COUNT(*) AS prix_null_restants
FROM ventes_propres
WHERE prix_unitaire IS NULL;


-- ============================================================
-- PARTIE 6 : ANALYSES POST-NETTOYAGE
-- ============================================================
-- Maintenant que la base est propre, on peut enfin répondre
-- aux vraies questions métier de la pharmacie.
-- ============================================================


-- ------------------------------------------------------------
-- ANALYSE 1 : Chiffre d'affaires par médicament
-- ------------------------------------------------------------
-- Impossible à calculer AVANT nettoyage à cause des NULL
-- et des noms en doublon. Maintenant c'est trivial.
-- ------------------------------------------------------------

SELECT
    medicament,
    COUNT(*)                                         AS nb_ventes,
    SUM(quantite)                                    AS unites_vendues,
    ROUND(SUM(quantite * prix_unitaire), 2)          AS ca_total,
    ROUND(AVG(prix_unitaire), 2)                     AS prix_moyen
FROM ventes_propres
GROUP BY medicament
ORDER BY ca_total DESC;


-- ------------------------------------------------------------
-- ANALYSE 2 : Performance par vendeur
-- ------------------------------------------------------------

SELECT
    vendeur,
    COUNT(*)                                         AS nb_ventes,
    SUM(quantite)                                    AS unites_vendues,
    ROUND(SUM(quantite * prix_unitaire), 2)          AS ca_total,
    ROUND(
        SUM(quantite * prix_unitaire) * 100.0 /
        (SELECT SUM(quantite * prix_unitaire) FROM ventes_propres),
        1
    )                                                AS part_ca_pct
FROM ventes_propres
GROUP BY vendeur
ORDER BY ca_total DESC;


-- ------------------------------------------------------------
-- ANALYSE 3 : Évolution mensuelle du CA
-- ------------------------------------------------------------

SELECT
    strftime('%Y-%m', date_vente)                    AS mois,
    COUNT(*)                                         AS nb_ventes,
    SUM(quantite)                                    AS unites_vendues,
    ROUND(SUM(quantite * prix_unitaire), 2)          AS ca_mensuel
FROM ventes_propres
GROUP BY mois
ORDER BY mois ASC;
